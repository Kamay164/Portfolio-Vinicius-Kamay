# Copie para .env (local) ou cadastre em Vercel > Settings > Environment Variables.
# Nunca coloque segredos neste arquivo: ele vai para o Git.

# Domínio final do site, com https:// e sem barra no fim (usado no canonical e no sitemap).
# Em branco, o build usa a URL de produção da Vercel. Definir na Etapa 11.
SITE_URL=

# "true" libera a indexação pelos buscadores. Mantenha vazio ou "false" até o lançamento (Etapa 11).
PUBLIC_ALLOW_INDEXING=false

# Chave pública do Web3Forms para o formulário de contato (Etapa 7).
PUBLIC_WEB3FORMS_KEY=
