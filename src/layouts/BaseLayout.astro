---
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/plus-jakarta-sans/latin-800.css';
import '@/styles/global.css';

import { siteConfig } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteConfig.title, description = siteConfig.description } = Astro.props;

// Até o lançamento (Etapa 11) o site fica fora dos buscadores: evita indexar a URL provisória da
// Vercel e duplicar conteúdo com o domínio final. No lançamento, PUBLIC_ALLOW_INDEXING=true.
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndexing ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#FBFBF9" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a
      href="#conteudo"
      class="rounded-pill bg-primary focus:not-sr-only sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-5 focus:py-3 focus:font-semibold focus:text-white"
    >
      Ir para o conteúdo
    </a>
    <slot />
  </body>
</html>
