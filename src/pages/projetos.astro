---
import ProjectCard from '@/components/projects/ProjectCard.astro';
import Button from '@/components/ui/Button.astro';
import { projectCategoryIds, projectCategoryLabels } from '@/data/project-categories';
import { projectsPage } from '@/data/projects-section';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects } from '@/lib/projects';
import { whatsAppLink } from '@/lib/whatsapp';

const projects = await getProjects();

// Só vira botão de filtro a categoria que tem pelo menos um projeto (evita filtro vazio).
const categories = projectCategoryIds
  .map((id) => ({
    id,
    label: projectCategoryLabels[id],
    count: projects.filter((p) => p.data.category === id).length,
  }))
  .filter((category) => category.count > 0);

const p = projectsPage;
---

<BaseLayout title={p.title} description={p.description}>
  <section aria-labelledby="projetos-title" class="section-y pt-12 sm:pt-16">
    <div class="container-page">
      <header class="max-w-2xl">
        <p class="text-eyebrow text-primary uppercase">{p.eyebrow}</p>
        <h1 id="projetos-title" class="text-display mt-4">
          {p.heading}
        </h1>
        <p class="mt-6 text-lg text-muted">{p.intro}</p>
      </header>

      {/* Os filtros dependem de JavaScript; sem ele ficam escondidos e todos os projetos aparecem. */}
      <div data-filters hidden class="mt-10">
        <p id="filtro-label" class="text-sm font-semibold text-ink-2">
          {p.filterLabel}
        </p>
        <div role="group" aria-labelledby="filtro-label" class="mt-3 flex flex-wrap gap-2">
          <button type="button" data-filter="all" aria-pressed="true" class="filter-chip">
            {p.allLabel} <span class="text-muted">({projects.length})</span>
          </button>
          {categories.map((category) => (
            <button
              type="button"
              data-filter={category.id}
              aria-pressed="false"
              class="filter-chip"
            >
              {category.label} <span class="text-muted">({category.count})</span>
            </button>
          ))}
        </div>
      </div>

      <p data-filter-status aria-live="polite" class="sr-only"></p>

      <ul data-project-list class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <ProjectCard project={project} headingLevel="h2" />
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="projetos-cta" data-theme="dark" class="section-y bg-ink text-white">
    <div class="container-page max-w-3xl text-center">
      <h2 id="projetos-cta" class="text-h2">
        {p.ctaTitle}
      </h2>
      <p class="mt-4 text-lg text-white/80">{p.ctaText}</p>
      <Button href={whatsAppLink('general')} variant="secondary" size="lg" external class="mt-8">
        {p.ctaButton}
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  @reference '../styles/global.css';

  .filter-chip {
    @apply inline-flex min-h-11 items-center gap-1.5 rounded-pill border-[1.5px] border-border bg-surface px-4 text-[0.9375rem] font-semibold transition-colors hover:bg-tint;
  }

  .filter-chip[aria-pressed='true'] {
    @apply border-primary bg-primary text-white;
  }

  .filter-chip[aria-pressed='true'] span {
    /* Branco puro: o branco a 80% sobre o cobalto fica em 4:1 e reprova. */
    @apply text-white;
  }
</style>

<script>
  // Filtro por tipo: esconde os cards de outras categorias e anuncia o resultado a leitores de tela.
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const list = document.querySelector<HTMLElement>('[data-project-list]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  if (filters && list && status) {
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...list.querySelectorAll<HTMLElement>('[data-project-category]')];

    const apply = (filter: string): void => {
      let visible = 0;
      for (const card of cards) {
        const show = filter === 'all' || card.dataset.projectCategory === filter;
        card.hidden = !show;
        if (show) visible += 1;
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
      }
      status.textContent = `${visible} ${visible === 1 ? 'projeto' : 'projetos'} na lista.`;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
    }

    filters.hidden = false;
  }
</script>
