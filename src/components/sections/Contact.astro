---
import Button from '@/components/ui/Button.astro';
import { contactSection } from '@/data/contact';
import { siteConfig } from '@/data/site';
import { whatsAppLink } from '@/lib/whatsapp';

const { eyebrow, title, text, cta, emailLabel } = contactSection;
---

<!-- Faixa marinha: data-theme="dark" troca o anel de foco para o azul da logo (contraste 6,5:1). -->
<section
  id="contato"
  aria-labelledby="contato-title"
  data-theme="dark"
  class="section-y bg-ink text-white"
>
  <div class="container-page max-w-3xl text-center">
    <p class="text-eyebrow text-accent uppercase">{eyebrow}</p>
    <h2 id="contato-title" class="text-h2 mt-3">
      {title}
    </h2>
    <p class="mt-4 text-lg text-white/80">{text}</p>
    <Button href={whatsAppLink('general')} variant="secondary" size="lg" external class="mt-8">
      {cta}
    </Button>
    <p class="mt-6 text-white/80">
      {emailLabel}{' '}
      <a
        href={`mailto:${siteConfig.email}`}
        class="font-semibold text-white underline underline-offset-4 break-words"
      >
        {siteConfig.email}
      </a>
    </p>
  </div>
</section>
