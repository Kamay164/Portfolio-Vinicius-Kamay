---
import ProjectCard from '@/components/projects/ProjectCard.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import { projectsSection } from '@/data/projects-section';
import { getFeaturedProjects, getProjects } from '@/lib/projects';

const { eyebrow, title, intro, allProjectsLabel } = projectsSection;
const [featured, all] = await Promise.all([getFeaturedProjects(), getProjects()]);
// O link para a página completa só aparece quando há projetos além dos destaques.
const hasMore = all.length > featured.length;
---

<Section id="projetos" eyebrow={eyebrow} title={title} intro={intro} tone="tint">
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {featured.map((project) => (
      <ProjectCard project={project} />
    ))}
  </ul>
  <Button href="/projetos" variant="secondary" size="lg" class="mt-10">
    {hasMore ? `${allProjectsLabel} (${all.length})` : allProjectsLabel}
  </Button>
</Section>
