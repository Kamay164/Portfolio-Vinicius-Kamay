---
import ExternalMark from '@/components/ui/ExternalMark.astro';

/**
 * Botão em forma de link: toda ação do site leva a uma URL ou âncora.
 * O botão de envio do formulário (Etapa 7) será um <button> à parte.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  /** Abre em nova aba, com seta visual e aviso para leitores de tela. */
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', external = false, class: className } = Astro.props;

// A borda existe nas duas variantes para que tenham exatamente a mesma altura lado a lado.
const variants = {
  primary: 'border-transparent bg-primary text-white hover:bg-primary-hover',
  secondary: 'border-border bg-surface text-ink hover:bg-tint',
} as const satisfies Record<NonNullable<Props['variant']>, string>;

// Altura mínima de 44 px (alvo de toque confortável) em todos os tamanhos.
const sizes = {
  sm: 'min-h-11 px-5 py-2.5 text-[0.9375rem]',
  md: 'min-h-12 px-6 py-3.5 text-base',
  lg: 'min-h-14 px-8 py-4 text-lg',
} as const satisfies Record<NonNullable<Props['size']>, string>;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-pill border-[1.5px] font-semibold transition-colors',
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
  {external && <ExternalMark />}
</a>
