---
import { Image } from 'astro:assets';

import logo from '@/assets/brand/logo-horizontal.svg';
import ExternalMark from '@/components/ui/ExternalMark.astro';
import { footerNav } from '@/data/navigation';
import { siteConfig } from '@/data/site';
import { whatsAppLink } from '@/lib/whatsapp';

// O site é estático: o ano é calculado no build e muda no primeiro deploy do ano seguinte.
const year = new Date().getFullYear();

const linkClass = 'transition-colors hover:text-primary';
const labelClass = 'text-eyebrow uppercase text-muted';
---

<footer class="bg-tint pt-16 pb-28 md:pb-12">
  <div class="container-page">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_0.8fr_1.4fr_0.8fr]">
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" aria-label={`${siteConfig.name}, página inicial`} class="inline-block">
          <Image src={logo} alt="" class="h-10 w-auto" />
        </a>
        <p class="mt-4 max-w-xs text-muted">
          Sites e landing pages para empresas de todo o Brasil.
        </p>
      </div>

      <nav aria-labelledby="footer-nav">
        <h2 id="footer-nav" class={labelClass}>
          Navegação
        </h2>
        <ul class="mt-4 space-y-3">
          {footerNav.map((item) => (
            <li>
              <a href={item.href} class={linkClass}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 id="footer-contato" class={labelClass}>
          Contato
        </h2>
        <ul class="mt-4 space-y-3" aria-labelledby="footer-contato">
          <li>
            <a
              href={whatsAppLink('general')}
              target="_blank"
              rel="noopener noreferrer"
              class={linkClass}
            >
              WhatsApp <span class="whitespace-nowrap">{siteConfig.whatsapp.display}</span>
              <ExternalMark />
            </a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.email}`} class={`${linkClass} break-words`}>
              {siteConfig.email}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 id="footer-redes" class={labelClass}>
          Redes
        </h2>
        <ul class="mt-4 space-y-3" aria-labelledby="footer-redes">
          {siteConfig.socials.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
                {social.label}
                <ExternalMark />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="mt-12 border-t border-ink/10 pt-6 text-sm text-muted">
      © {year} {siteConfig.name}. Todos os direitos reservados.
    </p>
  </div>
</footer>
