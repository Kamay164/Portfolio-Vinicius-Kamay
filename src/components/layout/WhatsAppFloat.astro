---
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { siteConfig } from '@/data/site';
import { whatsAppLink } from '@/lib/whatsapp';

// Verde do WhatsApp com ícone marinho (8,4:1). O ícone sozinho não tem texto, então o nome
// acessível vem do aria-label, que também avisa que o link abre em outra aba.
// O <aside> dá ao botão um landmark próprio: todo conteúdo da página fica dentro de uma região.
---

<aside aria-label="Contato rápido">
  <a
    href={whatsAppLink('general')}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Falar com ${siteConfig.name.split(' ')[0]} no WhatsApp (abre em nova aba)`}
    class="fixed right-4 bottom-4 z-50 inline-flex size-14 items-center justify-center rounded-pill bg-whatsapp text-ink shadow-soft transition-colors hover:bg-whatsapp-hover sm:right-6 sm:bottom-6"
  >
    <WhatsAppIcon class="size-7" />
  </a>
</aside>
